# Copy to .env and fill in. .env is git- and docker-ignored.
# Paper mode needs none of these. Testnet needs testnet keys. Live needs live keys.

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OKX (passphrase is mandatory on OKX)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Logging: overrides [logging].level, e.g. info, debug, bookend=debug,hyper=warn
RUST_LOG=info

# Which config to run under docker compose: paper | testnet | live
MM_MODE=paper

# Required for live mode. Leave unset otherwise.
# ENABLE_LIVE_TRADING=true
